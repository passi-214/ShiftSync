# All settings are optional. Copy to .env and uncomment what you need.
# Full list and meaning: docs/09-operations.md

# NUXT_SESSION_TTL_HOURS=168
# NUXT_MAX_UPLOAD_BYTES=5242880
# NUXT_CALENDAR_TIMEZONE=Europe/Berlin
# NUXT_CALENDAR_ADDRESS="Theater Freiburg, Bertoldstraße 46, 79098 Freiburg"
# NUXT_ESTIMATION_RECEPTION_DURATION_MIN=90
# NUXT_ESTIMATION_AFTER_SHOW_DURATION_MIN=90

# Direct "add to Google Calendar" (OAuth client of type "Web application")
# NUXT_GOOGLE_CLIENT_ID=
# NUXT_GOOGLE_CLIENT_SECRET=
# NUXT_GOOGLE_REDIRECT_URI=
